# ─────────────────────────────────────────
# CooCoo煮煮 後端環境變數設定
# 複製這個檔案為 .env，填入你自己的金鑰
# cp .env.example .env
# ─────────────────────────────────────────

# 伺服器設定
PORT=5001
NODE_ENV=development   # development | production

# Google Gemini AI（必填，取得方式：https://aistudio.google.com/apikey）
# 如果設為 MOCK_GEMINI_KEY 或留空，伺服器會自動切換為 Mock 模式（適合本地開發）
GEMINI_API_KEY=MOCK_GEMINI_KEY

# Supabase（部署時必填，取得方式：https://supabase.com/dashboard/project/_/settings/api）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
