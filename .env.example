# Web build (publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local UI preview only. Never enable in a production deployment.
VITE_USE_MOCK_API=false
# Set true only when the local API server is also running on port 3000.
VITE_USE_REAL_API=false

# API server (secret values; never expose with a VITE_ prefix)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only key for new Supabase projects.
SUPABASE_SECRET_KEY=
# Legacy compatibility only. Leave blank when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Server-only OpenRouter settings. Never prefix these with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=CooCoo
PORT=3000
